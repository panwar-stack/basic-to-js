10 REM Complex suite example: survey scores.
20 DIM SCORE(3)
30 DIM TAG$(3)
40 INPUT "PLAYER"; NAME$
50 INPUT "ROUNDS"; N
60 GOSUB 500
70 IF N < 1 THEN 300 ELSE 80
75 ' Main scoring loop starts after input validation.
80 TOTAL = 0
90 FOR I = 1 TO N
100 INPUT "SCORE"; SCORE(I)
110 IF SCORE(I) < 0 THEN SCORE(I) = 0 ELSE SCORE(I) = SCORE(I) + 1
120 TOTAL = TOTAL + SCORE(I)
130 IF SCORE(I) >= 10 THEN TAG$(I) = "HIGH" ELSE TAG$(I) = "LOW"
140 PRINT "ROUND "; I; ": "; TAG$(I), "ABS"; ABS(SCORE(I))
150 NEXT I
160 AVG = INT(TOTAL / N)
170 GOSUB 600
180 I = 1
190 IF I > N THEN 300 ELSE 200
200 PRINT "ITEM "; I; "="; SCORE(I); " "; TAG$(I)
210 I = I + 1
220 GOTO 190
300 PRINT "DONE"
310 END
500 IF N > 3 THEN N = 3 ELSE N = N
510 PRINT "HELLO "; LEFT$(NAME$, 3); " LEN"; LEN(NAME$)
520 PRINT "USING "; N; " ROUNDS"
530 RETURN
600 PRINT "TOTAL", TOTAL, "AVG", AVG
610 RETURN
