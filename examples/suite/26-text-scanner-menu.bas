10 REM Complex suite example: text scanner and menu.
20 DIM SNAP$(5)
30 INPUT "TEXT"; TEXT$
40 INPUT "KEY"; KEY$
50 INPUT "MODE"; MODE
60 GOSUB 500
70 MATCHES = 0
80 VOWELS = 0
90 FOR I = 1 TO LEN(TEXT$)
100 CH$ = MID$(TEXT$, I, 1)
110 IF I <= 5 THEN SNAP$(I) = CH$ ELSE CH$ = CH$
120 IF CH$ = KEY$ THEN MATCHES = MATCHES + 1 ELSE MATCHES = MATCHES
130 IF CH$ = "A" OR CH$ = "E" OR CH$ = "I" OR CH$ = "O" OR CH$ = "U" THEN VOWELS = VOWELS + 1 ELSE VOWELS = VOWELS
140 NEXT I
150 PRINT "MATCHES "; MATCHES; " VOWELS"; VOWELS
160 IF MODE = 1 THEN 220 ELSE 170
170 IF MODE = 2 THEN 260 ELSE 300
220 PRINT "LEFT "; LEFT$(TEXT$, 3); " RIGHT "; RIGHT$(TEXT$, 3)
230 GOTO 300
260 I = 1
270 IF I > 5 OR I > LEN(TEXT$) THEN 300 ELSE 280
280 PRINT "SNAP "; I; "="; SNAP$(I)
290 I = I + 1
295 GOTO 270
300 PRINT "TEXT DONE"
310 END
500 IF MODE < 1 THEN MODE = 1 ELSE MODE = MODE
510 IF MODE > 2 THEN MODE = 2 ELSE MODE = MODE
520 PRINT "LEN "; LEN(TEXT$); " KEY "; KEY$; " MODE"; MODE
530 RETURN
