10 REM Complex suite example: order scorecard.
20 DIM ITEM$(3)
30 DIM QTY(3)
40 DIM PRICE(3)
50 INPUT "CUSTOMER"; C$
60 INPUT "ITEMS"; N
70 GOSUB 700
80 IF N < 1 THEN 500 ELSE 90
90 TOTAL = 0: FLAGS = 0
100 FOR I = 1 TO N
110 INPUT "CODE"; ITEM$(I)
120 INPUT "QTY"; QTY(I)
130 INPUT "PRICE"; PRICE(I)
140 LINE = QTY(I) * PRICE(I)
150 IF QTY(I) >= 10 OR LINE >= 100 THEN FLAGS = FLAGS + 1 ELSE FLAGS = FLAGS
160 TOTAL = TOTAL + LINE
170 IF LEFT$(ITEM$(I), 1) = "X" THEN PRINT "SPECIAL "; RIGHT$(ITEM$(I), LEN(ITEM$(I)) - 1) ELSE PRINT "ITEM "; ITEM$(I)
180 PRINT "LINE "; I; " "; QTY(I); "X"; PRICE(I); "="; LINE
190 NEXT I
200 AVG = INT(TOTAL / N)
210 GOSUB 800
220 FOR I = 1 TO N
230 IF QTY(I) >= 10 AND PRICE(I) >= 5 THEN PRINT "BULK "; I; " "; ITEM$(I) ELSE PRINT "REG "; I; " "; ITEM$(I)
240 NEXT I
250 PRINT "DONE"
260 END
500 PRINT "NO ITEMS"
510 PRINT "DONE"
520 END
700 IF N > 3 THEN N = 3 ELSE N = N
710 IF N < 0 THEN N = 0 ELSE N = N
720 PRINT "ORDER "; LEFT$(C$, 4); " LEN"; LEN(C$)
730 PRINT "COUNT "; N
740 RETURN
800 PRINT "TOTAL "; TOTAL; " AVG"; AVG; " FLAGS"; FLAGS
810 RETURN
