10 REM Complex suite example: inventory restock.
20 DIM SKU$(4)
30 DIM QTY(4)
40 DIM PRICE(4)
50 DIM VALUE(4)
60 INPUT "CLERK"; CLERK$
70 INPUT "ITEMS"; N
80 GOSUB 500
90 IF N < 1 THEN 300 ELSE 100
100 TOTAL = 0
110 LOW = 0
120 FOR I = 1 TO N
130 INPUT "SKU"; SKU$(I)
140 INPUT "QTY"; QTY(I)
150 INPUT "PRICE"; PRICE(I)
160 IF QTY(I) < 0 THEN QTY(I) = 0 ELSE QTY(I) = QTY(I)
170 VALUE(I) = QTY(I) * PRICE(I)
180 TOTAL = TOTAL + VALUE(I)
190 IF QTY(I) <= 2 OR PRICE(I) > 50 THEN LOW = LOW + 1 ELSE LOW = LOW
200 PRINT LEFT$(SKU$(I), 3); " Q"; QTY(I); " V"; INT(VALUE(I)); " T"; RIGHT$(SKU$(I), 2)
210 NEXT I
220 GOSUB 600
230 I = 1
240 IF I > N THEN 300 ELSE 250
250 IF QTY(I) <= 2 THEN PRINT "RESTOCK "; SKU$(I); " BY "; 5 - QTY(I) ELSE PRINT "OK "; SKU$(I)
260 I = I + 1
270 GOTO 240
300 PRINT "INVENTORY DONE"
310 END
500 IF N > 4 THEN N = 4 ELSE N = N
510 PRINT "CLERK "; LEFT$(CLERK$, 4); " LEN"; LEN(CLERK$)
520 PRINT "COUNT "; N
530 RETURN
600 AVG = INT(TOTAL / N)
610 PRINT "TOTAL "; TOTAL; " AVG"; AVG; " FLAGS"; LOW
620 RETURN
