10 REM Complex suite example: route planner.
20 DIM STOP$(4)
30 DIM MILES(4)
40 INPUT "ROUTE"; ROUTE$
50 INPUT "LEGS"; N
60 GOSUB 600
70 TOTAL = 0
80 FOR I = 1 TO N
90 INPUT "STOP"; STOP$(I)
100 INPUT "MILES"; MILES(I)
110 TOTAL = TOTAL + ABS(MILES(I))
120 IF MILES(I) < 0 THEN PRINT "LEG "; I; " BACK "; STOP$(I); " "; ABS(MILES(I)) ELSE PRINT "LEG "; I; " OUT "; STOP$(I); " "; MILES(I)
130 NEXT I
140 PRINT "TOTAL "; TOTAL
150 PRINT "CODE "; LEFT$(ROUTE$, 2); "-"; RIGHT$(ROUTE$, 2); " MID"; MID$(ROUTE$, 2, 3)
160 T = 0
170 FOR I = N TO 1 STEP -1
180 T = T + ABS(MILES(I))
190 IF T >= 10 THEN PRINT "RETURN "; I; " "; STOP$(I); " LONG"; T ELSE PRINT "RETURN "; I; " "; STOP$(I); " SHORT"; T
200 NEXT I
210 GOSUB 700
220 PRINT "DONE"
230 END
600 IF N > 4 THEN N = 4 ELSE N = N
610 IF N < 1 THEN N = 1 ELSE N = N
620 PRINT "PLAN "; ROUTE$; " LEGS"; N
630 RETURN
700 A$ = MID$(ROUTE$, 3, 2)
710 IF VAL(A$) >= 10 THEN PRINT "SERIES "; VAL(A$) ELSE PRINT "SERIES LOW"
720 RETURN
